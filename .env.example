# Backend (server)
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netiv

# Storage local (pasta storage/empreendimentos na raiz do projeto)
# STORAGE_EMPREENDIMENTOS=  (opcional; padrão: ./storage/empreendimentos)

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Meta / WhatsApp Webhook
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Frontend (opcional — proxy do Vite usa backend em localhost:3001)
# VITE_API_URL=

# ── Escopo por equipe (SSO QMAPE) ──
# Liga o filtro que mostra ao usuário apenas leads dos empreendimentos da equipe dele.
# Mantenha 'false' até que:
#   (a) este código esteja em produção,
#   (b) o QMAPE atualizado também esteja em produção,
#   (c) os usuários ativos tenham passado por SSO ao menos uma vez (popula app_users).
# Liga e desliga sem deploy: basta restart do Netiv após mudar.
# TEAM_SCOPE_ENFORCED=false
