# Backend (server)
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netiv

# Storage local (pasta storage/empreendimentos na raiz do projeto)
# STORAGE_EMPREENDIMENTOS=  (opcional; padrão: ./storage/empreendimentos)

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Trava emergencial da Ana (true/1/yes/on => responde somente handoff humano)
# ANA_EMERGENCY_HANDOFF=false

# Meta / WhatsApp Webhook
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Template de notificacao para corretor no handoff da Ana
BROKER_PENDING_ATTENDANCE_TEMPLATE_NAME=corretor_atendimento_pendente
BROKER_PENDING_ATTENDANCE_TEMPLATE_LANGUAGE=pt_BR
BROKER_PENDING_ATTENDANCE_TEMPLATE_ENABLED=false

# Push mobile para corretor no handoff da Ana
BROKER_PUSH_NOTIFICATION_ENABLED=true

# Frontend (opcional — proxy do Vite usa backend em localhost:3001)
VITE_REALTIME_ENABLED=true
# No Amplify, VITE_REALTIME_ENABLED precisa estar true no ambiente de build.
# VITE_API_URL=<backend-url>

# Frontend URL para montar links de deep-link em webhooks (ex: https://netiv.seudominio.com)
NETIV_FRONTEND_URL=

