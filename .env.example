# Backend (server)
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netiv
# Origens web permitidas no backend e no Socket.IO (lista separada por virgulas).
# CORS_ORIGIN=https://app.exemplo.com
# FRONTEND_URL=https://app.exemplo.com

# Storage local (pasta storage/empreendimentos na raiz do projeto)
# STORAGE_EMPREENDIMENTOS=  (opcional; padrão: ./storage/empreendimentos)

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ana LLM provider/custo
# ANA_PROVIDER=bedrock
# ANA_BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b
# ANA_MAX_OUTPUT_TOKENS=220
# ANA_RAG_MAX_CHUNKS=3
# ANA_RAG_MAX_CONTEXT_CHARS=9000
# ANA_PROMPT_KNOWLEDGE_MAX_CHARS=6000
# ANA_RECENT_MESSAGES_MAX=8
# ANA_TARGET_INPUT_TOKENS=1500
# ANA_WARN_INPUT_TOKENS=3000
# ANA_SHRINK_INPUT_TOKENS=4000
# ANA_BLOCK_INPUT_TOKENS=5000
# ANA_DISABLE_SAME_CONTEXT_RETRY_ABOVE=3500
# ANA_PRICE_MISSING_NO_LLM=true
# ANA_TOKEN_AUDIT_ENABLED=true

# Trava emergencial da Ana (true/1/yes/on => responde somente handoff humano)
# ANA_EMERGENCY_HANDOFF=false

# Meta / WhatsApp Webhook
META_VERIFY_TOKEN=
META_APP_SECRET=
META_WEBHOOK_ALLOW_UNSIGNED=false
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Seed de acessos web (use apenas durante a execucao controlada do seed).
# INITIAL_ACCESS_PASSWORD=

# SSO web opcional, com JWT HS256 de curta duracao.
# SSO_SHARED_SECRET=
# SSO_EXPECTED_ISSUER=
# SSO_EXPECTED_AUDIENCE=
# SSO_MAX_TOKEN_TTL_SECONDS=300
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# AUTH_SSO_RATE_LIMIT_MAX=20
# AUTH_SSO_RATE_LIMIT_WINDOW_MS=900000

# Template de notificacao para corretor no handoff da Ana
BROKER_PENDING_ATTENDANCE_TEMPLATE_NAME=corretor_atendimento_pendente
BROKER_PENDING_ATTENDANCE_TEMPLATE_LANGUAGE=pt_BR
BROKER_PENDING_ATTENDANCE_TEMPLATE_ENABLED=true

# Template de notificacao para corretor quando visita e confirmada
BROKER_APPOINTMENT_CONFIRMED_TEMPLATE_NAME=corretor_agendamento_confirmado
BROKER_APPOINTMENT_CONFIRMED_TEMPLATE_LANGUAGE=pt_BR
BROKER_APPOINTMENT_CONFIRMED_TEMPLATE_ENABLED=true

# Push mobile para corretor no handoff da Ana
BROKER_PUSH_NOTIFICATION_ENABLED=true

# Notificacoes operacionais destinadas ao gestor sao opt-in e ficam desligadas por padrao.
MANAGER_NOTIFICATIONS_ENABLED=false

# Frontend (opcional — proxy do Vite usa backend em localhost:3001)
VITE_REALTIME_ENABLED=true
# No Amplify, VITE_REALTIME_ENABLED precisa estar true no ambiente de build.
# VITE_API_URL=<backend-url>
# VITE_SSO_ALLOWED_ORIGINS=https://app.exemplo.com

# Frontend URL para montar links de deep-link em webhooks (ex: https://netiv.seudominio.com)
NETIV_FRONTEND_URL=

