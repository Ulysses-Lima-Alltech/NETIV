{
  "name": "inbox-app-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "node dist/index.js",
    "build": "tsc || echo \"TypeScript errors ignored for deploy build\" && node scripts/copy-migrations.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:compiled": "node scripts/clean-compiled-tests.cjs && npm run build && node --test dist/tests/**/*.test.js",
    "migrate": "tsx db/migrate.ts",
    "migrate:deploy": "node dist/db/migrate.js",
    "seed:mobile-users": "tsx scripts/seed-mobile-users.ts",
    "seed:initial-access": "tsx scripts/seed-initial-access-users.ts",
    "seed:initial-access:prod": "node dist/scripts/seed-initial-access-users.js",
    "seed:mobile-conversations:dev": "tsx scripts/seed-mobile-conversations-dev.ts",
    "seed:mobile-visits:dev": "tsx scripts/seed-mobile-visits-dev.ts",
    "seed:mobile-team:dev": "tsx scripts/seed-mobile-team-dev.ts",
    "start:prod": "node dist/index.js",
    "kb:ingest": "tsx scripts/ingestEnterpriseKnowledge.ts",
    "kb:migrate:r2-s3": "tsx scripts/migrateKnowledgeStorageR2ToS3.ts",
    "kb:migrate:r2-s3:prod": "node dist/scripts/migrateKnowledgeStorageR2ToS3.js",
    "diagnose:lead-classifier": "node dist/scripts/diagnoseLeadClassifier.js",
    "backfill:lead-classifier": "node dist/scripts/backfillLeadClassification.js",
    "anagraph:harness": "tsx scripts/anaGraphComparisonHarness.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1058.0",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/client-transcribe": "^3.1114.0",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "form-data": "^4.0.0",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
