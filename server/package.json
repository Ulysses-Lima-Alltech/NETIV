{
  "name": "inbox-app-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "node dist/index.js",
    "build": "tsc || echo \"TypeScript errors ignored for deploy build\" && node scripts/copy-migrations.cjs",
    "migrate": "tsx db/migrate.ts",
    "migrate:deploy": "node dist/db/migrate.js",
    "start:prod": "node dist/db/migrate.js && node dist/index.js",
    "kb:ingest": "tsx scripts/ingestEnterpriseKnowledge.ts",
    "kb:migrate:r2-s3": "tsx scripts/migrateKnowledgeStorageR2ToS3.ts",
    "kb:migrate:r2-s3:prod": "node dist/scripts/migrateKnowledgeStorageR2ToS3.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "form-data": "^4.0.0",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
