PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netiv
# Caminho local para cache de arquivos de empreendimento.
# Padrão: {raiz do monorepo}/storage/empreendimentos
# Em produção com S3 configurado, este diretório serve como cache temporário.
# A fonte de verdade operacional para materiais de conhecimento é o S3.
# STORAGE_EMPREENDIMENTOS=

# -- Cloudflare R2 (DEPRECATED / legado) -------------------------------------
# Runtime produtivo de materiais de conhecimento não usa mais R2.
# Mantenha somente para scripts legados temporários (ex.: migração R2 -> S3).
# CLOUDFLARE_R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.seudominio.com

# -- S3 oficial da base de conhecimento (obrigatório para runtime) ------------
# Bucket oficial para uploads de materiais e artefatos raw/extracted/normalized/manifests/failed.
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_REGION=us-east-1
# Opcional para S3 compatível.
# KNOWLEDGE_S3_ENDPOINT=
# KNOWLEDGE_S3_FORCE_PATH_STYLE=false
# KNOWLEDGE_S3_ACCESS_KEY_ID=
# KNOWLEDGE_S3_SECRET_ACCESS_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Backend identity metadata (for /health)
# BACKEND_PROVIDER=aws
# APP_ENVIRONMENT=production
# APP_VERSION=1.0.0
# APP_COMMIT=<git_sha>

META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Seed do primeiro usuário ADMIN (opcional; padrão: admin@netiv.com / admin123)
# SEED_ADMIN_EMAIL=admin@netiv.com
# SEED_ADMIN_PASSWORD=admin123
# SEED_ADMIN_NAME=Administrador

# Bypass temporário da autenticação local no backend.
# true => rotas protegidas aceitam contexto embutido (sem Bearer), preservando requireAuth/requireRole.
# false (ou ausente) => autenticação normal por sessão/Bearer.
# AUTH_BYPASS_ENABLED=true
