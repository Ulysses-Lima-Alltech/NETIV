# Servidor (opcional: padrões usados se não definir)
PORT=3001
NODE_ENV=development
DB_PATH=./data/inbox.db

# OpenAI (rotas /api/openai/test, /api/ai/chat e webhook WhatsApp)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Meta / WhatsApp Webhook (obrigatório para GET/POST /webhook)
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v23.0
