PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netiv
# Caminho local para cache de arquivos de empreendimento.
# Padrão: {raiz do monorepo}/storage/empreendimentos
# Em produção com R2 configurado, este diretório serve apenas como cache temporário;
# o R2 é a fonte de verdade e o arquivo é restaurado aqui automaticamente se necessário.
# STORAGE_EMPREENDIMENTOS=

# ── Cloudflare R2 (storage persistente) ──────────────────────────────────────
# Configure estas variáveis no Render para usar o R2 como storage definitivo dos PDFs.
# Sem elas, o sistema usa o disco local + BYTEA no Postgres como fallback (legado).
#
# Como obter os valores:
#   1. Acesse Cloudflare Dashboard > R2 Object Storage.
#   2. Crie um bucket (anote o nome).
#   3. Acesse "Manage R2 API Tokens" > Create API Token com permissão "Object Read & Write".
#   4. Copie Access Key ID, Secret Access Key e Account ID.
#   5. O endpoint S3 do R2 é: https://<accountId>.r2.cloudflarestorage.com
#   6. (Opcional) Configure Custom Domain no bucket para URL pública.
#
# CLOUDFLARE_R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.seudominio.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Seed do primeiro usuário ADMIN (opcional; padrão: admin@netiv.com / admin123)
# SEED_ADMIN_EMAIL=admin@netiv.com
# SEED_ADMIN_PASSWORD=admin123
# SEED_ADMIN_NAME=Administrador
