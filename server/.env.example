PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netiv
# CORS_ORIGIN=https://app.exemplo.com
# FRONTEND_URL=https://app.exemplo.com
# Caminho local para cache de arquivos de empreendimento.
# Padrão: {raiz do monorepo}/storage/empreendimentos
# Em produção com S3 configurado, este diretório serve como cache temporário.
# A fonte de verdade operacional para materiais de conhecimento é o S3.
# STORAGE_EMPREENDIMENTOS=

# -- Cloudflare R2 (DEPRECATED / legado) -------------------------------------
# Runtime produtivo de materiais de conhecimento não usa mais R2.
# Mantenha somente para scripts legados temporários (ex.: migração R2 -> S3).
# CLOUDFLARE_R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.seudominio.com

# -- S3 oficial da base de conhecimento (obrigatório para runtime) ------------
# Bucket oficial para uploads de materiais e artefatos raw/extracted/normalized/manifests/failed.
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_REGION=us-east-1
# Opcional para S3 compatível.
# KNOWLEDGE_S3_ENDPOINT=
# KNOWLEDGE_S3_FORCE_PATH_STYLE=false
# KNOWLEDGE_S3_ACCESS_KEY_ID=
# KNOWLEDGE_S3_SECRET_ACCESS_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ana LLM provider/custo
# ANA_PROVIDER=bedrock
# ANA_BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b
# ANA_MAX_OUTPUT_TOKENS=220
# ANA_RAG_MAX_CHUNKS=3
# ANA_RAG_MAX_CONTEXT_CHARS=9000
# ANA_PROMPT_KNOWLEDGE_MAX_CHARS=6000
# ANA_RECENT_MESSAGES_MAX=8
# ANA_TARGET_INPUT_TOKENS=1500
# ANA_WARN_INPUT_TOKENS=3000
# ANA_SHRINK_INPUT_TOKENS=4000
# ANA_BLOCK_INPUT_TOKENS=5000
# ANA_DISABLE_SAME_CONTEXT_RETRY_ABOVE=3500
# ANA_PRICE_MISSING_NO_LLM=true
# ANA_TOKEN_AUDIT_ENABLED=true

# Trava emergencial da Ana (true/1/yes/on => responde somente handoff humano)
# ANA_EMERGENCY_HANDOFF=false

# Trava temporária de handoff automático.
# false (padrão) => nenhum fluxo automático da Ana muda conversa para Handoff.
# true => reativa handoff automático (usar somente quando a regra estiver validada).
# AUTO_HANDOFF_ENABLED=false

# Backend identity metadata (for /health)
# BACKEND_PROVIDER=aws
# APP_ENVIRONMENT=production
# APP_VERSION=1.0.0
# APP_COMMIT=<git_sha>

META_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Seed de acessos web e SSO seguro.
# INITIAL_ACCESS_PASSWORD=
# SSO_SHARED_SECRET=
# SSO_EXPECTED_ISSUER=
# SSO_EXPECTED_AUDIENCE=
# SSO_MAX_TOKEN_TTL_SECONDS=300
# Rate limit local por instância. Em múltiplas tasks ECS, cada task mantém seus próprios contadores.
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# AUTH_SSO_RATE_LIMIT_MAX=20
# AUTH_SSO_RATE_LIMIT_WINDOW_MS=900000

# Token dos endpoints mobile (/api/mobile/auth/*)
# Defina um segredo forte para assinatura JWT (obrigatorio para login mobile).
# MOBILE_AUTH_JWT_SECRET=troque-por-um-segredo-forte
# Opcional: expira em segundos (padrao: 2592000 = 30 dias)
# MOBILE_AUTH_TOKEN_TTL_SECONDS=2592000

# Template de notificacao para corretor no handoff da Ana
BROKER_PENDING_ATTENDANCE_TEMPLATE_NAME=corretor_atendimento_pendente
BROKER_PENDING_ATTENDANCE_TEMPLATE_LANGUAGE=pt_BR
BROKER_PENDING_ATTENDANCE_TEMPLATE_ENABLED=true

# Template de notificacao para corretor quando visita e confirmada
BROKER_APPOINTMENT_CONFIRMED_TEMPLATE_NAME=corretor_agendamento_confirmado
BROKER_APPOINTMENT_CONFIRMED_TEMPLATE_LANGUAGE=pt_BR
BROKER_APPOINTMENT_CONFIRMED_TEMPLATE_ENABLED=true

# Push mobile para corretor no handoff da Ana
BROKER_PUSH_NOTIFICATION_ENABLED=true

# Limite de tentativas do worker de sync NETIV -> Django (djangoSyncWorker.ts)
# antes de marcar o lead como dead-letter (para de reenviar automaticamente).
# Cada tentativa = 1 tick de 10s. Padrão: 30 (~5 minutos).
DJANGO_SYNC_MAX_ATTEMPTS=10
