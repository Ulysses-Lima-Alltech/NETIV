PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netiv
# Caminho absoluto para armazenamento dos arquivos de empreendimento.
# Padrão: {raiz do monorepo}/storage/empreendimentos
#
# IMPORTANTE — ambientes com filesystem efêmero (ex: Render sem Persistent Disk):
#   Os bytes do arquivo são persistidos automaticamente no PostgreSQL (coluna file_data,
#   migration 027) e restaurados em disco sob demanda. Ainda assim, recomenda-se
#   configurar um Persistent Disk no Render e apontar esta variável para o ponto de montagem:
#   STORAGE_EMPREENDIMENTOS=/data/storage/empreendimentos
#
# STORAGE_EMPREENDIMENTOS=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Seed do primeiro usuário ADMIN (opcional; padrão: admin@netiv.com / admin123)
# SEED_ADMIN_EMAIL=admin@netiv.com
# SEED_ADMIN_PASSWORD=admin123
# SEED_ADMIN_NAME=Administrador
